# Copy to runtime.local.sh and fill in your own absolute paths.
# runtime_env.sh supplies ROBODOCTOR_ROOT before sourcing this file.
export ROBODOJO_SOURCE=""
export ROBODOJO_PYTHON=""
export CODEX_BIN="codex"  # Resolved through PATH; an explicit executable also works.
export CODEX_CONFIG="$ROBODOCTOR_ROOT/codex.toml"

# Needed only for PrismWAM RSI / the nine-iteration pipeline.
export PRISMWAM_PYTHON=""
export PRISMWAM_CHECKPOINT=""
export PRISMWAM_CONFIG="$ROBODOCTOR_ROOT/robodoctor/prismwam/config.yaml"
export PRISMWAM_ASSETS_ROOT=""
export PRISMWAM_DEPTH_VAE=""  # Absolute path to downloaded robodojo/depth_vae.pt.

# Optional Pi05 backend: set its source and pass --student-python explicitly.
# export OPENPI_SOURCE=""

# Only needed if your existing NVIDIA graphics libraries are outside system paths.
# export DAGGER_NVIDIA_RUNTIME=""
# export DAGGER_SYSROOT=""
# export SIM_EXTRA_LIBRARY_PATH=""
# export VK_ICD_FILENAMES=""
# export __EGL_VENDOR_LIBRARY_FILENAMES=""
